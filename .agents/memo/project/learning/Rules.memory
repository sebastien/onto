      },
      "authoritative-specs": {
        "title": "Treat specifications as authoritative",
        "text": "When implementing behaviour, treat docs/specs/ as authoritative. If a spec is ambiguous or appears wrong, stop and ask the user; report mismatches rather than diverging or silently weakening the spec.",
        "children": [],
        "sources": [
          "identity==\"project:observations\" item=k-1bc032dde0ae8e7ee6fcf2a11780d761e68259cb974f545058e06f8b9326061c"
