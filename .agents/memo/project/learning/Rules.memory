      "dependency-boundary": {
        "title": "Keep runtime dependencies minimal",
        "text": "For runtime code, use only the Python >= 3.14 standard library. hexa is allowed only in its optional integration and must never be imported by onto core; pytest and jsonschema are development/test-only.",
        "children": [],
        "sources": [
          "identity==\"project:observations\" item=k-f6aaa38952166655ca48a174c7588b6c011ac6838530d3d4f6d4473f3da8a770"
        ],
        "review": false
      },
      "feature-package-layout": {
        "title": "Use the feature-package layout",
        "text": "When adding a format, organize it under src/py/onto/{feature}/ with model.py, parser.py, formatter.py, operations.py (operations under an Operator class holding context), and public __init__.py. Optional integrations go under src/py/onto/integrations/{name}/ and load their library only when imported. Canonical layout: domain/pattern:FeaturePackage.",
        "children": [],
        "sources": [
          "identity==\"project:observations\" item=k-7a136b2f2cc9d5426d49e3d9a7ab97a2f566d49556bf0ddcd8f5847a0e60c2b6"
        ],
        "review": false
      },
      "hexa-boundary": {
        "title": "Keep hexa domain-free",
        "text": "Maintain the one-way dependency boundary: onto may depend on hexa, but hexa must remain domain-free and never depend on onto. Adapt in onto's integration rather than changing hexa, and ask the user before modifying sibling repository ../hexa.",
        "children": [],
        "sources": [
          "identity==\"project:observations\" item=k-4c2d81c36912f76db8c26f75a3aae92bf740d39ad9a35b8f75623396cd7a3592"
        ],
        "review": false
      },
      "knowledge-placement": {
        "title": "Put durable knowledge in the knowledge store",
        "text": "Store durable design knowledge (architecture, components, patterns, and rationale-backed decisions) in .memo/domain; maintain decisions in domain/collection:Decisions with DEC codes, status, and date, and conventions in usage/guide:Conventions. Keep TODO.md for open work only, with one-line proposals linking proposed decision entries. Do not narrate completed progress in TODO.md; git history retains it.",
        "children": [],
        "sources": [
          "identity==\"project:observations\" item=k-21079e58423c1ecaa5fc181bacc7e8cd959f337377e7362cd1b6c7a1d75647a1"
        ],
        "review": false
      },
