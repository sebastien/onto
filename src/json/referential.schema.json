{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onto.example/schemas/referential.schema.json",
  "title": "Referential, JSON form (spec-05)",
  "description": "Structural schema for identity policies. Types, keys (`{key}` attributes) and `from` ontologies are checked by loading the document against its ontologies, not by this schema.",
  "type": "object",
  "required": ["format", "namespace", "policies"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "onto.referential/1" },
    "namespace": { "$ref": "#/$defs/path" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "rev": { "$ref": "#/$defs/token" } }
    },
    "uses": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/path" }
    },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "path": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$" },
    "token": { "type": "string", "pattern": "^[^\\s{},=]+$" },
    "doc": { "type": "string", "minLength": 1, "pattern": "^[^\\n\\r]*$" },
    "keys": {
      "description": "Key attributes in order; the first of a `key` policy is the primary key.",
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" }
    },
    "policy": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "oneOf": [
        { "description": "`key` policy: handles derived from the primary key.", "required": ["keys"], "not": { "required": ["minted"] } },
        { "description": "`minted` policy: generated handles; keys are alternate keys.", "required": ["minted"], "not": { "required": ["from"] } },
        { "description": "No identity policy; only the implicit-instance age.", "required": ["implicit"], "not": { "anyOf": [{ "required": ["keys"] }, { "required": ["minted"] }, { "required": ["from"] }] } }
      ],
      "properties": {
        "type": { "$ref": "#/$defs/path" },
        "keys": { "$ref": "#/$defs/keys" },
        "minted": { "const": true },
        "from": { "$ref": "#/$defs/path" },
        "implicit": {
          "description": "How long an instance may stay implicit before a warning: an ISO 8601 duration, or `never`.",
          "anyOf": [{ "const": "never" }, { "type": "string", "pattern": "^P(?=\\d|T\\d)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$" }]
        },
        "doc": { "$ref": "#/$defs/doc" }
      }
    }
  }
}
